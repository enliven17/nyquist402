# Testnet only. Run pnpm setup-demo once to create testnet accounts and official USDC trustlines (no minting).
# Keep secrets in .env.local, which Git ignores. Never expose them as NEXT_PUBLIC_*.
DEMO_AGENT_SECRET=
DEMO_MERCHANT_SECRET=
DEMO_FACILITATOR_SECRET=
# Legacy basic reference only; the unified demo pins official Circle testnet USDC.
DEMO_TOKEN=

# Protected contract ID, distinct from the basic auth-capture deployment.
# The SDK reads its immutable default arbiter and checks its payment identity onchain.
DEMO_PROTECTED_ESCROW=CCQLNKUMUSMJ2L7KAH7VJSCXW6FOBLI3VAPZO4ZLCDEQ4PL76FDXKCEW
# Generate once: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep stable across restarts, or existing seller delegations stop working.
DEMO_SESSION_SECRET=
# Optional custom arbiter preference of the demonstration seller; blank means none.
DEMO_SELLER_ARBITER=

# Demo-operated arbiters, comma-separated testnet secrets. The first must be the protected
# escrow's default arbiter; the rest are buyer-selectable. They rule for free in the demo.
DEMO_ARBITER_SECRETS=

# Durable private local service data. Do not commit or publicly serve this directory.
DEMO_DATA_DIR=.nyquist-data

# Existing deployment is immutable fee-free v1. A v2 address is required before changing this.
DEMO_PROTECTED_VERSION=1
# v2 amounts are seven-decimal USDC base-unit strings, additional to principal.
DEMO_PROTOCOL_RESERVE=0
DEMO_ARBITRATION_RESERVE=0
DEMO_PROTOCOL_BPS=0
DEMO_PROTOCOL_RECIPIENT=
DEMO_CASE_FEE_CAP=0

DEMO_CUSTOM_FEE=0
DEMO_DEFAULT_FEE=0
# Optional deadline worker. Requires a funded testnet transaction signer.
DEMO_WORKER_ENABLED=false
